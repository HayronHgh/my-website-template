{
  "name": "portfolio-content-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "package:dist": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File scripts/package-dist.ps1",
    "start": "next start",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts",
    "admin:generate-secret": "tsx scripts/generate-admin-secret.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "check": "pnpm audit:prod && pnpm typecheck && pnpm validate:content && pnpm test:run && pnpm lint && pnpm build && git diff --check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.14.0",
    "mermaid": "12.0.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "shiki": "^4.4.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  }
