{
  "version": 1,
  "title": "PSO 參數收斂實驗",
  "description": "調整粒子數、迭代次數與 PSO 係數，觀察一維 Sphere function 的收斂軌跡。",
  "timeoutMs": 5000,
  "parameters": [
    { "key": "particles", "label": "粒子數", "min": 4, "max": 100, "step": 1, "default": 24, "description": "每輪參與搜尋的粒子數量。" },
    { "key": "iterations", "label": "迭代次數", "min": 5, "max": 200, "step": 5, "default": 50, "description": "群體更新的總輪數。" },
    { "key": "inertia", "label": "慣性權重", "min": 0.1, "max": 1.2, "step": 0.05, "default": 0.7, "description": "保留前一輪速度的比例。" },
    { "key": "cognitive", "label": "個體係數", "min": 0, "max": 3, "step": 0.1, "default": 1.4, "description": "粒子靠近個體最佳位置的強度。" },
    { "key": "social", "label": "群體係數", "min": 0, "max": 3, "step": 0.1, "default": 1.4, "description": "粒子靠近群體最佳位置的強度。" },
    { "key": "seed", "label": "Random seed", "min": 1, "max": 9999, "step": 1, "default": 42, "description": "固定後可重現相同實驗。" }
  ],
  "sampleResult": {
    "summary": "24 個粒子在 50 輪內逐步逼近 Sphere function 的理論最小值；曲線使用 log scale 呈現後期收斂差異。",
    "metrics": [
      { "label": "Best position", "value": -0.000031 },
      { "label": "Best score", "value": 9.61e-10 },
      { "label": "Iterations", "value": 50, "unit": "rounds" },
      { "label": "Particles", "value": 24, "unit": "agents" }
    ],
    "plots": [{
      "title": "Global best convergence",
      "xLabel": "Iteration",
      "yLabel": "Best score",
      "yScale": "log",
      "series": [{
        "label": "PSO",
        "color": "#a9d978",
        "points": [
          { "x": 1, "y": 0.84 }, { "x": 5, "y": 0.12 }, { "x": 10, "y": 0.0091 },
          { "x": 15, "y": 0.0014 }, { "x": 20, "y": 0.00019 }, { "x": 30, "y": 0.0000038 },
          { "x": 40, "y": 7.2e-8 }, { "x": 50, "y": 9.61e-10 }
        ]
      }]
    }],
    "tables": [{
      "title": "Selected checkpoints",
      "columns": ["Iteration", "Best position", "Best score"],
      "rows": [[1, -0.9165, 0.84], [10, 0.0954, 0.0091], [20, -0.0138, 0.00019], [30, 0.00195, 0.0000038], [40, -0.000268, 7.2e-8], [50, -0.000031, 9.61e-10]]
    }]
  }
}
